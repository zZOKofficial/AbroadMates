{"_id":"68eebf84ad2fd1180101a2f3","name":"Parinda Rahman","slug":"parinda-rahman","bio":"I’m a Computer Science Master’s graduate from the University of British Columbia (UBC), where I completed my studies on a full scholarship, and a Computer Science BSc graduate from North South University, with an online BSc in Psychology from the University of Derby. I have research experience in ethical technology and UX, along with hands-on work in data science and human-computer interaction. Having studied in Bangladesh and Canada, I’ve learned to adapt quickly, communicate across cultures, and thrive in diverse academic and professional environments. Fluent in English, I’m passionate about helping students navigate study abroad journeys and maximize their global education opportunities.","profilePicture":"../res.cloudinary.com/dcrm3y8x2/image/upload/v1760606022/abroadmates/mentors/bzzhsmm39a3yxg9tuqd2.jpg","coverPhoto":"","country":"Canada","homeCountry":"","universityName":"University of British Columbia","universityCountry":"Canada","universityCountries":["Canada","United Kingdom","United States"],"universityCity":"","major":"Computer science","program":"Master's","howICanHelp":["Roadmap","Essay Review","Scholarships","Visa Application","ECA Guidance","Personal Statement","Recommendation Letters","University Application","Life Abroad","Abroad Career","Test Prep"],"mentorInfoStatus":"alumni","countriesApplied":["United Kingdom","Canada","United States of America","Bangladesh","United States"],"appliedUniversities":[{"name":"University of British Columbia","accepted":"accepted","scholarship":"100%","location":"Canada","currentlyStudying":false,"attendanceStatus":"attended","degree":"Master's","fieldOfStudy":"Computer science","city":"","admissionYear":2023,"graduationDate":"2025-06-30T00:00:00.000Z","_id":"6a6e24c66a68affe4d1919a9"},{"name":"University of Calgary","accepted":"accepted","scholarship":"50%","location":"Canada","currentlyStudying":false,"attendanceStatus":"acce